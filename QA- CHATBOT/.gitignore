# =============================================================
# .gitignore  —  V2 UPDATED
# =============================================================
#
# NEW ADDITIONS vs V1:
#   faiss_index/ — remove from git so test data never deploys again
#   chunks.pkl   — same reason
#   document_registry.pkl — same reason
#   documents/*.pdf — never commit personal test PDFs
#
# =============================================================

# --- Secret keys ---
.env
.env.local
.env.production

# --- Python virtual environment ---
venv/
env/
.venv/

# --- Python bytecode ---
__pycache__/
*.pyc
*.pyo

# --- ✅ NEW: Remove pre-baked indexes from deployment ---
# These were accidentally committed in V1 causing all users
# to search Mohith's personal test documents instead of their own.
# In V2 all indexes live in Redis, not on disk.
faiss_index/
chunks.pkl
document_registry.pkl

# --- Personal test documents ---
documents/*.pdf

# --- Logs ---
logs/
*.log

# --- Feedback data ---
feedback/

# --- OS files ---
.DS_Store
Thumbs.db

# --- IDE files ---
.vscode/
.idea/